# ==============================================================================
# SchoolPro Central Cloud Platform - Production Environment Variables
# ==============================================================================
# Copy this file to .env.production on the production VPS / server:
# cp .env.production.example .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain & SSL Configuration (Caddy Automatic HTTPS)
# ------------------------------------------------------------------------------
DOMAIN_NAME=schoolpro.yourdomain.com
ACME_EMAIL=admin@yourdomain.com
CORS_ORIGINS=https://schoolpro.yourdomain.com,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. PostgreSQL Production Credentials
# ------------------------------------------------------------------------------
POSTGRES_USER=schoolpro_admin
POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_HERE_32_CHARS
POSTGRES_DB=schoolpro_production

# ------------------------------------------------------------------------------
# 3. Redis In-Memory Store
# ------------------------------------------------------------------------------
REDIS_PASSWORD=GENERATE_STRONG_RANDOM_REDIS_PASSWORD_HERE

# ------------------------------------------------------------------------------
# 4. Central NestJS Application Security
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
JWT_SECRET=GENERATE_A_64_CHAR_HEX_STRING_FOR_JWT_SECURITY_MIN_32_CHARS
RUN_SEED=false

# ------------------------------------------------------------------------------
# 5. Ed25519 Central Authority Cryptographic Keys
# (Generate via: node packages/crypto-utils/dist/cli-keygen.js)
# ------------------------------------------------------------------------------
ED25519_PRIVATE_KEY=302e020100300506032b657004220420...REPLACE_WITH_BASE64_OR_HEX_KEY
ED25519_PUBLIC_KEY=302a300506032b6570032100...REPLACE_WITH_BASE64_OR_HEX_KEY
