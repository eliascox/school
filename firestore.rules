             isOptStr(data, 'schoolId', 0, 64) &&
             isOptTimestamp(data, 'updatedAt') &&
             isOptTimestamp(data, 'createdAt');
    }

    function isValidLedgerRecord(data) {
      let allowed = [
        'id', 'type', 'category', 'grade', 'studentName', 'studentRoll',
        'amount', 'voucherNo', 'date', 'paymentMethod', 'description',
        'createdByName', 'updatedAt', 'createdAt', 'schoolId'
      ];
      return data.keys().hasOnly(allowed) &&
             data.keys().size() <= 16 &&
             data.keys().hasAll(['id', 'type', 'category', 'amount', 'voucherNo', 'date']) &&
             isStr(data.id, 1, 100) &&
             data.type in ['Income', 'Expense'] &&
             isStr(data.category, 1, 120) &&
             isOptStr(data, 'grade', 0, 30) &&
             isOptStr(data, 'studentName', 0, 120) &&
             isOptStr(data, 'studentRoll', 0, 30) &&
             data.amount is number && data.amount > 0 && data.amount <= 100000000 &&
             isStr(data.voucherNo, 1, 100) &&
             isStr(data.date, 4, 64) &&
             (!('paymentMethod' in data) || data.paymentMethod in ['Cash', 'bKash', 'Nagad', 'Bank Transfer']) &&
             isOptStr(data, 'description', 0, 500) &&
             isOptStr(data, 'createdByName', 0, 120) &&
             isOptStr(data, 'schoolId', 0, 64) &&
             isOptTimestamp(data, 'updatedAt') &&
             isOptTimestamp(data, 'createdAt');
    }

    function isValidStipendStudent(data) {
      let allowed = [
        'id', 'studentId', 'name', 'studentName', 'roll', 'grade', 'section',
        'group', 'mobile', 'isStipend', 'stipendCategory', 'stipendStatus',
        'stipendStartMonth', 'monthlyAmount', 'attRate', 'examMarkAvg',
        'isEligible', 'bankAccount', 'mobileBankingNo', 'remarks',
        'createdAt', 'updatedAt', 'schoolId'
      ];
      return data.keys().hasOnly(allowed) &&
             data.keys().size() <= 26 &&
             data.keys().hasAll(['id', 'grade', 'roll']) &&
             (('name' in data && isStr(data.name, 1, 120)) ||
              ('studentName' in data && isStr(data.studentName, 1, 120))) &&
             isStr(data.id, 1, 120) &&
             isOptStr(data, 'studentId', 1, 120) &&
             isStr(data.grade, 1, 30) &&
             isStr(data.roll, 1, 30) &&
             isOptStr(data, 'section', 0, 40) &&
             isOptStr(data, 'group', 0, 60) &&
             isOptStr(data, 'mobile', 0, 40) &&
             isOptBool(data, 'isStipend') &&
             isOptStr(data, 'stipendCategory', 0, 100) &&
             (!('stipendStatus' in data) || data.stipendStatus in ['Active', 'Suspended', 'Revoked']) &&
             isOptStr(data, 'stipendStartMonth', 0, 40) &&
             isOptNum(data, 'monthlyAmount', 0, 100000) &&
             isOptNum(data, 'attRate', 0, 100) &&
             isOptNum(data, 'examMarkAvg', 0, 100) &&
             isOptBool(data, 'isEligible') &&
             isOptStr(data, 'bankAccount', 0, 80) &&
             isOptStr(data, 'mobileBankingNo', 0, 40) &&
             isOptStr(data, 'remarks', 0, 400) &&
             isOptStr(data, 'schoolId', 0, 64) &&
             isOptTimestamp(data, 'updatedAt') &&
             isOptTimestamp(data, 'createdAt');
    }

    function isValidTeacherLeave(data) {
      let allowed = [
        'id', 'teacherId', 'teacherName', 'designation', 'leaveType',
        'startDate', 'endDate', 'totalDays', 'reason', 'appliedAt',
        'status', 'reviewedBy', 'reviewedAt', 'remarks',
        'createdAt', 'updatedAt', 'schoolId'
      ];
      return data.keys().hasOnly(allowed) &&
             data.keys().size() <= 18 &&
             data.keys().hasAll(['id', 'teacherId', 'teacherName', 'leaveType', 'startDate', 'endDate', 'totalDays', 'reason', 'status']) &&
             isStr(data.id, 1, 100) &&
             isStr(data.teacherId, 1, 64) &&
             isStr(data.teacherName, 1, 120) &&
             isOptStr(data, 'designation', 0, 120) &&
             data.leaveType in ['casual', 'medical', 'maternity', 'emergency', 'earned'] &&
             isStr(data.startDate, 4, 40) &&
             isStr(data.endDate, 4, 40) &&
             data.totalDays is number && data.totalDays > 0 && data.totalDays <= 365 &&
             isStr(data.reason, 3, 2000) &&
             isOptStr(data, 'appliedAt', 0, 64) &&
             data.status in ['Pending', 'pending', 'Approved', 'approved', 'Rejected', 'rejected'] &&
             isOptStr(data, 'reviewedBy', 0, 120) &&
             isOptStr(data, 'reviewedAt', 0, 64) &&
             isOptStr(data, 'remarks', 0, 500) &&
             isOptStr(data, 'schoolId', 0, 64) &&
             isOptTimestamp(data, 'updatedAt') &&
             isOptTimestamp(data, 'createdAt');
    }

    function isValidSscTestimonial(data) {
      let allowed = [
        'id', 'studentId', 'studentName', 'fatherName', 'motherName',
        'village', 'postOffice', 'upazilla', 'upazila', 'district', 'dob',
        'dobWords', 'gender', 'schoolName', 'schoolNameEn', 'schoolAddress',
        'schoolAddressEn', 'eiin', 'boardName', 'centerName', 'group',
        'boardRoll', 'boardReg', 'session', 'passingYear', 'gpa', 'gradeLetter',
        'issueDate', 'refNo', 'characterRemarks', 'createdAt', 'updatedAt', 'schoolId'
      ];
      return data.keys().hasOnly(allowed) &&
             data.keys().size() <= 35 &&
             data.keys().hasAll(['id', 'studentName', 'boardRoll', 'passingYear', 'refNo']) &&
             isStr(data.id, 1, 120) &&
             isOptStr(data, 'studentId', 1, 120) &&
             isStr(data.studentName, 1, 120) &&
             isOptStr(data, 'fatherName', 0, 120) &&
             isOptStr(data, 'motherName', 0, 120) &&
             isOptStr(data, 'village', 0, 120) &&
             isOptStr(data, 'postOffice', 0, 120) &&
             isOptStr(data, 'upazilla', 0, 120) &&
             isOptStr(data, 'upazila', 0, 120) &&
             isOptStr(data, 'district', 0, 120) &&
             isOptStr(data, 'dob', 0, 40) &&
             isOptStr(data, 'dobWords', 0, 200) &&
             (!('gender' in data) || data.gender in ['Male', 'Female', 'Other']) &&
             isOptStr(data, 'schoolName', 0, 200) &&
             isOptStr(data, 'schoolNameEn', 0, 200) &&
             isOptStr(data, 'schoolAddress', 0, 300) &&
             isOptStr(data, 'schoolAddressEn', 0, 300) &&
             isOptStr(data, 'eiin', 0, 30) &&
             isOptStr(data, 'boardName', 0, 120) &&
             isOptStr(data, 'centerName', 0, 120) &&
             isOptStr(data, 'group', 0, 60) &&
             isStr(data.boardRoll, 1, 40) &&
             isOptStr(data, 'boardReg', 0, 40) &&
             isOptStr(data, 'session', 0, 40) &&
             isStr(data.passingYear, 1, 20) &&
             isOptStr(data, 'gpa', 0, 20) &&
             isOptStr(data, 'gradeLetter', 0, 10) &&
             isOptStr(data, 'issueDate', 0, 64) &&
             isStr(data.refNo, 1, 160) &&
             isOptStr(data, 'characterRemarks', 0, 1000) &&
             isOptStr(data, 'schoolId', 0, 64) &&
             isOptTimestamp(data, 'updatedAt') &&
             isOptTimestamp(data, 'createdAt');
    }

    function isValidClassRoutine(data) {
      let allowed = [
        'id', 'classId', 'grade', 'branch', 'day', 'dayBn', 'periodNo',
        'subject', 'teacherId', 'teacherName', 'roomNo',
        'createdAt', 'updatedAt', 'schoolId'
      ];
      return data.keys().hasOnly(allowed) &&
             data.keys().size() <= 16 &&
             data.keys().hasAll(['id', 'classId', 'day', 'periodNo', 'subject']) &&
             isStr(data.id, 1, 100) &&
             isStr(data.classId, 1, 64) &&
             isOptStr(data, 'grade', 0, 30) &&
             isOptStr(data, 'branch', 0, 40) &&
             data.day in ['Saturday', 'Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'] &&
             isOptStr(data, 'dayBn', 0, 40) &&
             data.periodNo is int && data.periodNo >= 1 && data.periodNo <= 12 &&
             isStr(data.subject, 1, 120) &&
             isOptStr(data, 'teacherId', 0, 64) &&
             isOptStr(data, 'teacherName', 0, 120) &&
             isOptStr(data, 'roomNo', 0, 40) &&
             isOptStr(data, 'schoolId', 0, 64) &&
             isOptTimestamp(data, 'updatedAt') &&
             isOptTimestamp(data, 'createdAt');
    }

    function isValidSystemHealth(data) {
      let allowed = ['timestamp', 'client', 'project', 'status', 'updatedAt', 'createdAt'];
      return data.keys().hasOnly(allowed) &&
             data.keys().size() <= 6 &&
             isOptTimestamp(data, 'timestamp') &&
             isOptStr(data, 'client', 0, 120) &&
             isOptStr(data, 'project', 0, 64) &&
             isOptStr(data, 'status', 0, 32) &&
             isOptTimestamp(data, 'updatedAt') &&
             isOptTimestamp(data, 'createdAt');
    }

    function isValidFcmToken(data) {
      let allowed = ['token', 'role', 'userAgent', 'platform', 'uid', 'subscribedAt', 'lastActiveAt'];
      return data.keys().hasOnly(allowed) &&
             data.keys().size() <= 8 &&
             data.keys().hasAll(['token', 'role']) &&
             isStr(data.token, 20, 500) &&
             data.role in ['admin', 'teacher', 'guardian'] &&
             isOptStr(data, 'userAgent', 0, 500) &&
             isOptStr(data, 'platform', 0, 64) &&
             isOptStr(data, 'uid', 0, 128) &&
             isOptTimestamp(data, 'subscribedAt') &&
             isOptTimestamp(data, 'lastActiveAt');
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    // 1. Public School Metadata ('settings/general' public read; admin-only write)
    match /settings/{docId} {
      allow read: if docId == 'general' || isAdmin();
      allow create: if isAdmin() && isValidSchoolSettings(request.resource.data);
      allow update: if isAdmin() &&
                       isValidSchoolSettings(request.resource.data) &&
                       areImmutableFieldsUnchanged(['createdAt']);
      allow delete: if isAdmin();
    }

    // 2. Public Landing Page CMS ('landing_page/published' public read; admin-only write)
    match /landing_page/{docId} {
      allow read: if docId == 'published' || isAdmin();
      allow create: if isAdmin() && isValidLandingPageConfig(request.resource.data);
      allow update: if isAdmin() &&
                       isValidLandingPageConfig(request.resource.data) &&
                       areImmutableFieldsUnchanged(['createdAt']);
      allow delete: if isAdmin();
    }

    // 3. Notices (public read for website & PWA; staff CRUD with schema validation)
    match /notices/{noticeId} {
      allow read: if true;
      allow create: if isStaff() && isValidNotice(request.resource.data);
      allow update: if isStaff() &&
                       isValidNotice(request.resource.data) &&
                       areImmutableFieldsUnchanged(['id', 'createdAt']);
      allow delete: if isStaff();
    }

    // 4. Classes & Sections (public read for portal/admission; admin-only write)
    match /classes/{classId} {
      allow read: if true;
      allow create: if isAdmin() && isValidClassItem(request.resource.data);
      allow update: if isAdmin() &&
                       isValidClassItem(request.resource.data) &&
                       areImmutableFieldsUnchanged(['id', 'createdAt']);
      allow delete: if isAdmin();
    }

    // 5. Academic Data (public single-doc get for 4 published docs; staff list; admin write)
    match /academic_data/{docId} {
      allow get: if docId in ['exam_setup', 'curriculum_subjects', 'session_setup', 'class_routines'] || isStaff();
      allow list: if isStaff();
      allow create: if isAdmin() && isValidAcademicDataDoc(docId, request.resource.data);
      allow update: if isAdmin() &&
                       isValidAcademicDataDoc(docId, request.resource.data) &&
                       areImmutableFieldsUnchanged(['createdAt']);
      allow delete: if isAdmin();
    }

    // 6. Teachers Directory & Credentials (sensitive: admin full; self get by teacherId claim; no public list)
    match /teachers/{teacherId} {
      allow get: if isAdmin() || hasMatchingTeacherId(teacherId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidTeacher(request.resource.data);
      allow update: if isAdmin() &&
                       isValidTeacher(request.resource.data) &&
                       areImmutableFieldsUnchanged(['id', 'createdAt']);
      allow delete: if isAdmin();
    }

    // 7. Students Roster (PII: staff read; admin-only CRUD with strict validation)
    match /students/{studentId} {
      allow read: if isStaff();
      allow create: if isAdmin() && isValidStudent(request.resource.data);
      allow update: if isAdmin() &&
                       isValidStudent(request.resource.data) &&
                       areImmutableFieldsUnchanged(['id', 'createdAt']);
      allow delete: if isAdmin();
    }

    // 8. Certificates (public single-doc get for QR verification; no unauthenticated list; staff create/update; admin delete)
    match /certificates/{certId} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if isStaff() && isValidCertificate(request.resource.data);
      allow update: if isStaff() &&
                       isValidCertificate(request.resource.data) &&
                       areImmutableFieldsUnchanged(['id', 'studentId', 'createdDate', 'createdAt']) &&
                       (!('status' in resource.data) ||
                        resource.data.status != 'cancelled' ||
                        (('status' in request.resource.data) && request.resource.data.status == 'cancelled'));
      allow delete: if isAdmin();
    }

    // 9. Exam Marks (staff read/create/update with score bounds; admin delete)
    match /exam_marks/{markId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidExamMark(request.resource.data);
      allow update: if isStaff() &&
                       isValidExamMark(request.resource.data) &&
                       areImmutableFieldsUnchanged(['createdAt', 'storageKey', 'studentId', 'examId']);
      allow delete: if isAdmin();
    }

    // 10. Attendance Records (staff read/create/update with key validation; admin delete)
    match /attendance_records/{recordId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidAttendanceRecord(request.resource.data);
      allow update: if isStaff() &&
                       isValidAttendanceRecord(request.resource.data) &&
                       areImmutableFieldsUnchanged(['createdAt', 'storageKey', 'studentId', 'date']);
      allow delete: if isAdmin();
    }

    // 11. Online Admission Applications (public create ONLY with status=='pending' & no admin fields; admin read/update/delete)
    match /online_applications/{appId} {
      allow read: if isAdmin();
      allow create: if isValidPublicOnlineApplication(request.resource.data) ||
                       (isAdmin() && isValidAdminOnlineApplication(request.resource.data));
      allow update: if isAdmin() &&
                       isValidAdminOnlineApplication(request.resource.data) &&
                       areImmutableFieldsUnchanged(['id', 'appId', 'appliedAt', 'createdAt']);
      allow delete: if isAdmin();
    }

    // 12. Financial & Administrative Collections (Admin only, except teacher_leaves & class_routines)
    match /fee_invoices/{invoiceId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidFeeInvoice(request.resource.data);
      allow update: if isAdmin() &&
                       isValidFeeInvoice(request.resource.data) &&
                       areImmutableFieldsUnchanged(['id', 'studentId', 'createdAt']);
      allow delete: if isAdmin();
    }

    match /fee_ledgers/{ledgerId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidFeeLedger(request.resource.data);
      allow update: if isAdmin() &&
                       isValidFeeLedger(request.resource.data) &&
                       areImmutableFieldsUnchanged(['studentId', 'createdAt']);
      allow delete: if isAdmin();
    }

    match /payroll_records/{payrollId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidPayrollRecord(request.resource.data);
      allow update: if isAdmin() &&
                       isValidPayrollRecord(request.resource.data) &&
                       areImmutableFieldsUnchanged(['id', 'teacherId', 'createdAt']);
      allow delete: if isAdmin();
    }

    match /expense_records/{expenseId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidExpenseRecord(request.resource.data);
      allow update: if isAdmin() &&
                       isValidExpenseRecord(request.resource.data) &&
                       areImmutableFieldsUnchanged(['id', 'createdAt']);
      allow delete: if isAdmin();
    }

    match /ledger_records/{ledgerId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidLedgerRecord(request.resource.data);
      allow update: if isAdmin() &&
                       isValidLedgerRecord(request.resource.data) &&
                       areImmutableFieldsUnchanged(['id', 'createdAt']);
      allow delete: if isAdmin();
    }

    match /stipend_students/{stipendId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidStipendStudent(request.resource.data);
      allow update: if isAdmin() &&
                       isValidStipendStudent(request.resource.data) &&
                       areImmutableFieldsUnchanged(['id', 'createdAt']);
      allow delete: if isAdmin();
    }

    match /teacher_leaves/{leaveId} {
      allow read: if isAdmin() ||
                     (isStaff() &&
                      resource != null &&
                      ('teacherId' in resource.data) &&
                      hasMatchingTeacherId(resource.data.teacherId));
      allow create: if isValidTeacherLeave(request.resource.data) &&
                       (isAdmin() ||
                        (isStaff() &&
                         hasMatchingTeacherId(request.resource.data.teacherId) &&
                         request.resource.data.status in ['Pending', 'pending'] &&
                         !('reviewedBy' in request.resource.data) &&
                         !('reviewedAt' in request.resource.data) &&
                         !('remarks' in request.resource.data) &&
                         (!('createdAt' in request.resource.data) || isRecent(request.resource.data.createdAt))));
      allow update: if isAdmin() &&
                       isValidTeacherLeave(request.resource.data) &&
                       areImmutableFieldsUnchanged(['id', 'teacherId', 'appliedAt', 'createdAt']);
      allow delete: if isAdmin();
    }

    match /ssc_testimonials/{testimonialId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidSscTestimonial(request.resource.data);
      allow update: if isAdmin() &&
                       isValidSscTestimonial(request.resource.data) &&
                       areImmutableFieldsUnchanged(['id', 'studentId', 'createdAt']);
      allow delete: if isAdmin();
    }

    match /class_routines/{routineId} {
      allow read: if isStaff();
      allow create: if isAdmin() && isValidClassRoutine(request.resource.data);
      allow update: if isAdmin() &&
                       isValidClassRoutine(request.resource.data) &&
                       areImmutableFieldsUnchanged(['id', 'createdAt']);
      allow delete: if isAdmin();
    }

    // 13. System Health Check (signed-in read; admin-only write)
    match /_system_health/{docId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidSystemHealth(request.resource.data);
      allow update: if isAdmin() &&
                       isValidSystemHealth(request.resource.data) &&
                       areImmutableFieldsUnchanged(['createdAt']);
      allow delete: if isAdmin();
    }

    // 14. FCM Push Notification Device Tokens (discovered in pushNotificationService.ts)
    match /fcm_tokens/{tokenId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
                       isValidFcmToken(request.resource.data) &&
                       uidUnchanged() &&
                       (request.resource.data.role == 'guardian' ||
                        (request.resource.data.role == 'teacher' && isStaff()) ||
                        (request.resource.data.role == 'admin' && isAdmin()));
      allow update: if isValidFcmToken(request.resource.data) &&
                       (isAdmin() ||
                        (isAuthenticated() &&
                         ('uid' in resource.data) &&
                         resource.data.uid is string &&
                         resource.data.uid == request.auth.uid &&
                         uidNotModified() &&
                         request.resource.data.role == resource.data.role &&
                         areImmutableFieldsUnchanged(['subscribedAt', 'token', 'role', 'uid']))) &&
                       areImmutableFieldsUnchanged(['subscribedAt']);
      allow delete: if isAdmin();
    }
  }
}
